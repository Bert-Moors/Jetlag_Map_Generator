{
  "config": {
    "name": "H+S Brussels"
  },
  "layers":{
      "Border":{
        "game zone border": {
          "geom_type": "border",
          "query": "[out:json][timeout:10];relation[\"name:nl\"=\"Brussel Hoofdstad\"];out geom;"
        }
      },
      "Public Utilities":{
        "Hospital": {
          "geom_type": "points",
          "query": "[out:json][timeout:10];\nrelation[\"name:nl\"=\"Brussel Hoofdstad\"] -> .boundary;\n.boundary map_to_area -> .searcharea;\nnwr[\"name\"~\".*\"][\"healthcare\"=\"hospital\"](area.searcharea);\nout center;"
        },
        "Library": {
          "geom_type": "points",
          "query": "[out:json][timeout:10];\nrelation[\"name:nl\"=\"Brussel Hoofdstad\"] -> .boundary;\n.boundary map_to_area -> .searcharea;\nnwr[\"amenity\"=\"library\"][\"name\"~\".*\"](area.searcharea);\nout center;"
        }
      },
      "Admin Divisions": {
        "3rd admin divisions": {
          "geom_type": "polygons",
          "query1": "[out:json][timeout:60];\nrelation[\"name:nl\"=\"Brussel Hoofdstad\"] -> .boundary;\n.boundary map_to_area -> .searcharea;\nrelation[\"name:nl\"=\"Elsene\"][\"admin_level\"=\"9\"][\"boundary\"=\"administrative\"](area.searcharea);\nout geom;",
          "query": "[out:json][timeout:60];\nrelation[\"name:nl\"=\"Brussel Hoofdstad\"] -> .boundary;\n.boundary map_to_area -> .searcharea;\nrelation[\"name\"~\".*\"][\"admin_level\"=\"9\"][\"boundary\"=\"administrative\"](area.searcharea);\nout geom;",
          "query3": "[out:json][timeout:60];\nrelation[\"name:nl\"=\"Brussel Hoofdstad\"] -> .boundary;\n.boundary map_to_area -> .searcharea;\nrelation[\"name:nl\"=\"Jette\"][\"admin_level\"=\"9\"][\"boundary\"=\"administrative\"](area.searcharea);\nout geom;"
        }
      },
      "Routes": {
        "Subway": {
          "geom_type": "routes",
          "query": "[out:json][timeout:60];\nrelation[\"name:nl\"=\"Brussel Hoofdstad\"] -> .boundary;\n.boundary map_to_area -> .searcharea;\nrelation[\"route\"=\"subway\"](area.searcharea);\nout geom;"
        }
      }
  }
}